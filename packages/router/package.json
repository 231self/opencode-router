{
  "name": "@231self/opencode-router",
  "version": "0.3.3",
  "description": "Per-turn model routing for OpenCode V2 and Kilo, decided by a small local judge (oMLX, llama.cpp, or any OpenAI-compatible server), with a WASM routing core. The context optimiser ships in @231self/opencode-compaction.",
  "type": "module",
  "license": "Apache-2.0",
  "author": "231self",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/231self/opencode-router.git",
    "directory": "packages/router"
  },
  "homepage": "https://github.com/231self/opencode-router#readme",
  "bugs": {
    "url": "https://github.com/231self/opencode-router/issues"
  },
  "exports": {
    ".": "./src/index.js",
    "./tui": "./src/tui.js"
  },
  "bin": {
    "opencode-model-router": "bin/omlx-router.mjs",
    "omlx-router": "bin/omlx-router.mjs"
  },
  "files": [
    "src",
    "dist/core.wasm",
    "bin",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "config.example.json"
  ],
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "opencode",
    "kilo",
    "plugin",
    "llm-router",
    "omlx",
    "mlx",
    "wasm"
  ],
  "dependencies": {
    "@231self/opencode-shared": "^0.1.1"
  },
  "scripts": {
    "build": "bun run build:wasm",
    "build:wasm": "bash ../../scripts/build-wasm.sh",
    "test": "bun run build:wasm && bun test",
    "test:rust": "cargo test --manifest-path core/Cargo.toml",
    "check": "bash ../../scripts/check.sh",
    "security": "node ../../scripts/security-check.mjs",
    "prepack": "bun run build:wasm",
    "test:e2e": "bun tests/e2e/run.mjs",
    "test:e2e:live": "bun tests/e2e/run.mjs --real-judge --only live-judge",
    "test:e2e:list": "bun tests/e2e/run.mjs --list",
    "judge:calibrate": "bun tests/judge-calibration.mjs",
    "routing:eval": "bun tests/routing-eval.mjs",
    "bench": "bun tests/benchmark.mjs",
    "bench:long": "bun tests/benchmark.mjs --long",
    "quality:eval": "bun tests/quality-eval.mjs"
  }
}
