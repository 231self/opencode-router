{
  "name": "opencode-router-workspace",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "bash scripts/build-wasm.sh",
    "build:wasm": "bash scripts/build-wasm.sh",
    "test": "bun run build:wasm && bun test",
    "test:rust": "cargo test --manifest-path packages/router/core/Cargo.toml && cargo test --manifest-path packages/compaction/core/Cargo.toml",
    "check": "bash scripts/check.sh",
    "security": "node scripts/security-check.mjs",
    "test:e2e": "bun packages/router/tests/e2e/run.mjs",
    "test:e2e:live": "bun packages/router/tests/e2e/run.mjs --real-judge --only live-judge",
    "test:e2e:list": "bun packages/router/tests/e2e/run.mjs --list",
    "judge:calibrate": "bun packages/router/tests/judge-calibration.mjs",
    "compaction:calibrate": "bun packages/compaction/tests/compaction-calibration.mjs",
    "compaction:ablation": "bun packages/compaction/tests/compaction-ablation.mjs",
    "compaction:report": "bun packages/compaction/tests/compaction-report.mjs",
    "tolerance:eval": "bun packages/compaction/tests/compaction-tolerance.mjs",
    "routing:eval": "bun packages/router/tests/routing-eval.mjs",
    "bench": "bun packages/router/tests/benchmark.mjs",
    "bench:long": "bun packages/router/tests/benchmark.mjs --long",
    "quality:eval": "bun packages/router/tests/quality-eval.mjs"
  }
}
